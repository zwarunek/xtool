                    </button>
                </subviews>
                <constraints>
                    <constraint firstItem="lbl-t0-001" firstAttribute="leading" secondItem="cnt-v0-001" secondAttribute="leading" constant="16" id="c01-aa-001"/>
                    <constraint firstItem="lbl-t0-001" firstAttribute="top" secondItem="cnt-v0-001" secondAttribute="top" constant="8" id="c02-aa-001"/>
                    <constraint firstAttribute="trailing" secondItem="swt-s0-001" secondAttribute="trailing" constant="16" id="c03-aa-001"/>
                    <constraint firstItem="swt-s0-001" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="lbl-t0-001" secondAttribute="trailing" constant="8" id="c04-aa-001"/>
                    <constraint firstItem="txt-f0-001" firstAttribute="top" secondItem="lbl-t0-001" secondAttribute="bottom" constant="12" id="c05-aa-001"/>
                    <constraint firstItem="txt-f0-001" firstAttribute="leading" secondItem="lbl-t0-001" secondAttribute="leading" id="c06-aa-001"/>
                    <constraint firstItem="sld-r0-001" firstAttribute="top" secondItem="txt-f0-001" secondAttribute="bottom" constant="6" priority="750" id="c07-aa-001"/>
                    <constraint firstItem="sld-r0-001" firstAttribute="leading" secondItem="cnt-v0-001" secondAttribute="leadingMargin" id="c08-aa-001"/>
                    <constraint firstAttribute="trailingMargin" secondItem="stp-r0-001" secondAttribute="trailing" id="c09-aa-001"/>
